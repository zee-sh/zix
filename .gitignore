# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Claude Code scratch state. Worktrees created here carry their own .git file, so
# git records them as gitlinks (mode 160000) if they are ever staged.
.claude/worktrees/

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history

# Ignore Claude Code local session state
.claude
