#!/usr/bin/env bash
#
# Formatting gate. Enable with `just hooks`. Versioned here rather than in
# .git/hooks so it is shared. Formatting only — the eval checks are too slow
# to run per commit, and CI covers them.
set -euo pipefail

# Nothing to do if nix is unavailable (e.g. a fresh machine mid-bootstrap).
if ! command -v nix >/dev/null 2>&1; then
  exit 0
fi

staged_nix=$(git diff --cached --name-only --diff-filter=ACM | grep '\.nix$' || true)
if [ -z "$staged_nix" ]; then
  exit 0
fi

# Check the staged blob, not the working tree. Formatting the tree and diffing
# gives a false positive on any unrelated unstaged edit (breaking `git add -p`)
# and misses staged content whenever the tree is already clean.
fmt() { nix run --inputs-from . nixpkgs#nixfmt -- --check - >/dev/null 2>&1; }

# Fail loudly if the formatter cannot run — offline, cold cache, bad input.
# Swallowing that would silently turn this hook into a no-op.
if ! printf '{ }\n' | fmt; then
  echo "pre-commit: cannot run the formatter (offline? cold cache?)." >&2
  echo "Fix it, or bypass once with: git commit --no-verify" >&2
  exit 1
fi

unformatted=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if ! git cat-file blob ":$f" | fmt; then
    unformatted="$unformatted  $f"$'\n'
  fi
done <<<"$staged_nix"

if [ -n "$unformatted" ]; then
  echo
  echo "pre-commit: these staged files are not formatted:"
  echo
  printf '%s' "$unformatted"
  echo "Run 'just fmt', re-stage, and commit again."
  echo "To bypass once: git commit --no-verify"
  exit 1
fi
