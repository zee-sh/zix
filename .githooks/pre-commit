#!/usr/bin/env bash
#
# Formatting gate. Enable with `just hooks`. Versioned here rather than in
# .git/hooks so it is shared. Formatting only — the eval checks are too slow
# to run per commit, and CI covers them.
set -euo pipefail

# Nothing to do if nix is unavailable (e.g. a fresh machine mid-bootstrap).
# Better to let the commit through than to block work CI will catch anyway.
if ! command -v nix >/dev/null 2>&1; then
  exit 0
fi

# Skip when no .nix file is staged; most commits here touch lua, md or yaml.
staged_nix=$(git diff --cached --name-only --diff-filter=ACM | grep '\.nix$' || true)
if [ -z "$staged_nix" ]; then
  exit 0
fi

# Exit status ignored on purpose: it reports on the working tree, but what
# matters is whether the *staged* content is formatted. Trusting the tree lets
# a second attempt through, once a prior run fixed the file but not the index.
nix run --inputs-from . nixpkgs#nixfmt-tree -- --ci >/dev/null 2>&1 || true

# A staged .nix file that now has unstaged changes means the formatter rewrote
# it, i.e. what is about to be committed is not formatted.
unformatted=""
for f in $staged_nix; do
  if ! git diff --quiet -- "$f" 2>/dev/null; then
    unformatted="$unformatted  $f"$'\n'
  fi
done

if [ -n "$unformatted" ]; then
  echo
  echo "pre-commit: staged nix files are not formatted."
  echo "They have been reformatted in place — review and re-stage:"
  echo
  printf '%s' "$unformatted"
  echo
  echo "  git add -u && git commit"
  echo
  echo "To bypass this check once: git commit --no-verify"
  exit 1
fi
